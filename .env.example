# ================================================================
# Plantilla de variables de entorno (.env.example)
# Copia este archivo a .env para ejecucion local:
#   cp .env.example .env
# ================================================================

PORT=8080

# Base de datos MySQL (local o en la nube como Aiven / TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_edificios
DB_USERNAME=root
DB_PASSWORD=
# Para BD en la nube usar REQUIRED o VERIFY_IDENTITY
DB_SSL_MODE=DISABLED

# Configuracion SMTP (JavaMail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Gestion de Edificios

# Seguridad JWT (Base64 >= 32 bytes)
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW11c3QtYmUtcmVwbGFjZWQ=
JWT_EXPIRATION_SECONDS=900
